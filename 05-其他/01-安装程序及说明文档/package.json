{
  "name": "medecho",
  "version": "2.0.0",
  "private": true,
  "description": "同频 MedEcho · 后端主导的 Agent Runtime（Case File + Agent Loop + Safety Engine + 5 个工具）",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --open",
    "migrate": "node scripts/migrate.js",
    "test": "node --test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.6.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
