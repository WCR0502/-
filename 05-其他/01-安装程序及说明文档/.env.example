# 同频 MedEcho · 环境变量示例
# 复制为 .env 后填写；.env 已在 .gitignore 中，不要提交。

# 服务
PORT=5173
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-32-bytes-random
NODE_ENV=development
LOG_LEVEL=info

# 模型（OpenAI 兼容接口）。留空 = 规则版，主流程仍可走通
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=qwen-flash
LLM_TIMEOUT_MS=25000

# 高德 Web 服务（逆地理 + 周边医院）。留空 = 前端落回内置演示数据
AMAP_WEB_KEY=REPLACE_ME

# 数据
DB_PATH=./data/medecho.db
SHARE_TTL_HOURS=24

# 医院收费系统（HIS）价目接口，留空 = 使用演示快照
HOSPITAL_NAME=本院
HOSPITAL_FEE_API_URL=
HOSPITAL_FEE_API_KEY=
HOSPITAL_FEE_AUTH_HEADER=Authorization
HOSPITAL_FEE_AUTH_SCHEME=Bearer 
HOSPITAL_FEE_TIMEOUT_MS=6000

# 限流
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_LLM_SESSION_HOUR=20
RATE_LIMIT_LLM_SESSION_DAY=100

# 5 个功能的 feature flag（关闭后主流程不受影响）
FEATURE_CAREKIT=1
FEATURE_COMMCARD=1
FEATURE_CARECIRCLE=1
FEATURE_TEACHBACK=1
FEATURE_EMERGENCYCARD=1
